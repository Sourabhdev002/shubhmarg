NEXT_PUBLIC_SUPABASE_URL=your_supabase_project_url
NEXT_PUBLIC_SUPABASE_ANON_KEY=your_supabase_anon_key
SUPABASE_SERVICE_ROLE_KEY=your_supabase_service_role_key

# Admin Dashboard Basic Auth Credentials
ADMIN_USERNAME=
ADMIN_PASSWORD=

# AstrologyAPI Calendar Integration (Server Only)
ASTROLOGY_API_ACCESS_TOKEN=your_access_token_here

# UPI payment + auto-verification
UPI_WEBHOOK_SECRET=long_random_secret_shared_with_gmail_script
NEXT_PUBLIC_UPI_VPA=your_upi_id@bank
NEXT_PUBLIC_UPI_PAYEE_NAME=YOUR REGISTERED NAME

# Telegram wallet top-up approvals
# 1. Message @BotFather → /newbot → copy the token here
TELEGRAM_BOT_TOKEN=123456:ABC-DEF_your_bot_token
# 2. Message your bot once, then open
#    https://api.telegram.org/bot<TOKEN>/getUpdates and copy your chat id
TELEGRAM_CHAT_ID=your_numeric_chat_id
# 3. Any long random string — used to secure the telegram webhook
TELEGRAM_WEBHOOK_SECRET=another_long_random_secret

# Google Gemini (AI readings / interpretations)
GEMINI_API_KEY=your_gemini_api_key
GEMINI_MODEL=gemini-3.6-flash

# Meta / Facebook Pixel (analytics — optional, disables pixel if unset)
NEXT_PUBLIC_META_PIXEL_ID=your_meta_pixel_id

# WhatsApp business number (digits only, country code, no "+" or spaces — wa.me format)
# Drives every "Chat / Order / Book on WhatsApp" link sitewide via src/config/contact.ts
NEXT_PUBLIC_WHATSAPP_NUMBER=919999999999
